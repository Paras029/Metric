# Credentials for SafeChain, which reads all three straight out of the environment. Nothing here
# mints a token or refreshes one: SafeChain owns that, which is why it is worth using.
#
# Paste the consumer secret exactly as the portal gives it to you. It arrives with its base64
# padding stripped and the decoder will not accept it that way; the padding is restored for you
# before SafeChain is loaded.
CIBIS_CONSUMER_SECRET=
CIBIS_CONSUMER_INTEGRATION_ID=

# The YAML that declares the models and the request body each one expects. Most teams share a
# template -- ask on the SafeChain channel if you do not have one.
CONFIG_PATH=config.yml

# Which model to use, named exactly as your config.yml names it. Not a provider path.
LLM_MODEL_ID=gemini-2.5-pro

# Where SafeChain keeps its model factory, as module:attribute. Leave this blank: several known
# paths are tried and one of them is almost certainly right. Set it only if a call fails saying
# the factory could not be found -- `python tools/find_safechain.py` prints the line to paste.
# SAFECHAIN_MODEL_FACTORY=safechain.core_model:model

# Optional tuning.
LLM_TEMPERATURE=0.3

# Calls run on one of four tiers. Each takes its own model, output cap and reasoning effort, and
# each falls back to LLM_MODEL_ID above, so nothing changes until a smaller model is named.
#
# JUDGEMENT — reading documents, drafting the intake, review. These read a lot, reason at length,
# and justify what they conclude. Reasoning tokens come out of the same budget as the reply, so a
# high effort against a small cap truncates the JSON rather than shortening the answer; the cap
# and the effort belong together.
LLM_JUDGEMENT_MAX_TOKENS=65536
LLM_JUDGEMENT_REASONING_EFFORT=high
# LLM_JUDGEMENT_MODEL_ID=
# LLM_JUDGEMENT_TEMPERATURE=

# MATERIALITY — weighing each scenario against its peers. Judgement-shaped work, but every chunk
# of the benchmark is sent at once rather than one call at a time, so this tier is kept separate
# from JUDGEMENT above: point it at a smaller model here without touching document reading or
# review, and it retries a busy gateway less aggressively by default (see LLM_MATERIALITY_MAX_
# ATTEMPTS below), so a lot of chunks in flight together do not turn one slow response into a
# pile of simultaneous retries.
LLM_MATERIALITY_MAX_TOKENS=32000
LLM_MATERIALITY_REASONING_EFFORT=medium
# LLM_MATERIALITY_MODEL_ID=
# LLM_MATERIALITY_TEMPERATURE=
LLM_MATERIALITY_MAX_ATTEMPTS=2

# STANDARD — writing each scenario up for the modelling team. Mechanical and bounded by the batch
# size, but people read the result, so it stays on the main model unless you say otherwise.
LLM_MAX_TOKENS=16000
LLM_REASONING_EFFORT=minimal
# LLM_MODEL_ID is the main model, set above.

# FAST — mapping the modelling team's free-text scenarios onto the intake's declared vocabulary.
# Classification against a closed list, with validation discarding anything outside it. Point
# this at the cheapest model that follows the output format.
LLM_FAST_MAX_TOKENS=8000
LLM_FAST_REASONING_EFFORT=minimal
# LLM_FAST_MODEL_ID=
# LLM_FAST_TEMPERATURE=

# Per-stage overrides. A tier above is shared by every call doing the same *kind* of work, which
# is coarser than every call *site* -- weighing a scenario's materiality and checking review's
# declared category are both Materiality-tier work, but they are two different calls a benchmark
# can want tuned differently. LLM_STAGE_<KEY>_* sets MODEL_ID / MAX_TOKENS / TEMPERATURE /
# REASONING_EFFORT / MAX_ATTEMPTS for one specific call site below, and BATCH_SIZE / CONCURRENCY
# for the ones that batch -- BATCH_SIZE is how many rows go into one call, CONCURRENCY is how
# many of those calls are ever in flight at once; they are independent knobs. Every field falls
# back to its tier's own setting where the stage does not override it, so setting nothing here
# changes nothing. <KEY> is one of:
#
#   INGEST_READ                 reading each facet group from the whole corpus  (Judgement)
#   INGEST_RESOLVE               the resolution sweep                          (Judgement)
#   INGEST_DIAGRAM_READ           reading one diagram image on its own          (Judgement)
#   INGEST_DIAGRAM_SYNTHESIZE      joining every image's reading into one graph  (Judgement)
#   INGEST_DIAGRAM_REPAIR          putting unresolved points back to the images  (Judgement)
#   INTAKE_DRAFT                 drafting or revising the intake                (Judgement)
#   STRUCTURE_REVIEW              proposing reconnections/consolidations         (Judgement)
#   WRITER                      writing scenario text          (Standard, batch 8)
#   MATERIALITY_ASSESS           weighing each scenario's materiality (Materiality, batch 10)
#   REVIEWER_ASSESS              review's materiality + flagging sweep (Judgement, batch 6)
#   REVIEWER_CATEGORY             review's declared-category check   (Materiality, batch 20)
#   REVIEWER_PROPOSE              review's addition proposals                    (Judgement)
#   OWNER_EXTRACT                mapping owner scenarios onto the vocabulary  (Fast, batch 8)
#
# Example -- run review's category check on a cheaper model, in smaller, more parallel calls,
# without touching materiality assessment even though both share the Materiality tier by default:
# LLM_STAGE_REVIEWER_CATEGORY_MODEL_ID=
# LLM_STAGE_REVIEWER_CATEGORY_BATCH_SIZE=10
# LLM_STAGE_REVIEWER_CATEGORY_CONCURRENCY=8

# How much submitted text goes into one reading call. Four characters to a token puts the default
# near 500k tokens, well inside a million-token input window. A pack larger than this is split
# across calls, which reads worse than reading it whole.
LLM_MAX_CORPUS_CHARS=2000000

# How many times a question the first reading left open is put back to the documents before it is
# put to the modelling team. Each pass is one call over the whole corpus, and each question it
# settles is one the team never has to answer. The last pass also decides which of the leftovers
# genuinely need a person; the rest are recorded but not asked. Set to 0 to skip the sweep, which
# is faster and asks considerably more.
LLM_INGEST_RESOLVE_PASSES=2

# How many batched calls run at once. Writing, materiality and review each split a benchmark into
# chunks and send every chunk's call together rather than one after another; this caps how many
# are in flight at the same time, so a large benchmark cannot open more connections than the
# gateway is willing to hold. Raise it if the gateway comfortably takes more; lower it if calls
# start failing under load.
LLM_MAX_CONCURRENCY=4

# How many times a failed call is retried before it is given up on, where a tier does not set its
# own (materiality does -- see LLM_MATERIALITY_MAX_ATTEMPTS above). A gateway that is briefly busy
# is worth retrying; a batch of many chunks all retrying at once under sustained load is not made
# better by trying each one four times, so lower this (or the materiality-specific one) if you are
# seeing repeated connection errors rather than the occasional one.
LLM_MAX_ATTEMPTS=4

# Diagram reading. Submitted workflow diagrams are described by the model where it accepts
# images; set this to "off" where the gateway rejects the multimodal request shape, and diagrams
# will instead be recorded as needing a written description.
LLM_VISION=on
LLM_MAX_IMAGE_BYTES=4000000

# PII/BI redaction. Every passage a submitted document is read into is redacted before it is
# joined into a corpus and before any of it reaches a model call -- see ingest/redaction.py. Off
# by default so the tool runs unmodified wherever the redaction package has not been installed
# yet; turn it on for anything but a local run against material that was never sensitive to begin
# with. Once on, a document that cannot be redacted stops the run rather than being sent
# unredacted -- this is not a best-effort extra.
#
# Requires the internal pii-redactor package (built on ee_utils.redaction) installed into this
# environment. Not on the internal index -- install it as an editable local package from wherever
# your team keeps it, e.g. pip install -e "C:\path\to\pii-redactor".
PII_REDACTION=off
PII_REDACTION_MODE=masking
PII_REDACTION_REPLACEMENT_TEXT=[REDACTED]

# strict | balanced | loose -- how aggressive the engine's fallback masking is where its primary
# detector misses something. Leave blank to take the engine's own default.
# PII_REDACTION_SENSITIVITY=

# Detector labels to switch off, and terms to leave alone regardless of what the engine would
# otherwise mask -- both comma-separated.
# PII_REDACTION_EXCLUDE_ENTITIES=
# PII_REDACTION_ALLOW=American Express,New York

# Per-entity confidence thresholds, as name=score pairs separated by commas.
# PII_REDACTION_THRESHOLDS=secondary_pii_email=0.7,secondary_pii_phone=0.7
