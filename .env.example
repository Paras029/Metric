# Authentication for the LLM gateway.
IDAAS_APP_ID=
IDAAS_KEY=
IDAAS_URL=

# The chat-completions endpoint and the model behind it. Any provider whose gateway accepts a
# standard chat-completions request body will work; set the model identifier and scope to match
# whatever the gateway expects.
LLM_ENDPOINT=
LLM_MODEL_ID=
LLM_SCOPE=

# Optional tuning.
LLM_TEMPERATURE=0.3

# Routine passes: writing descriptions, extracting metadata. Mechanical work, bounded replies.
LLM_MAX_TOKENS=16000
LLM_REASONING_EFFORT=minimal

# Judgement passes: materiality and review. These weigh each scenario against the whole
# benchmark and justify the verdict. Reasoning tokens are drawn from the same budget as the
# reply, so a high reasoning effort against a small cap truncates the JSON rather than
# shortening the answer — raise or lower these two together. Set either to "" to omit the
# field for gateways that reject it.
LLM_JUDGEMENT_MAX_TOKENS=32000
LLM_JUDGEMENT_REASONING_EFFORT=high

# Diagram reading. Submitted workflow diagrams are described by the model where it accepts
# images; set this to "off" where the gateway rejects the multimodal request shape, and diagrams
# will instead be recorded as needing a written description.
LLM_VISION=on
LLM_MAX_IMAGE_BYTES=4000000
