# Credentials for SafeChain, which reads all three straight out of the environment. Nothing here
# mints a token or refreshes one: SafeChain owns that, which is why it is worth using.
#
# Paste the consumer secret exactly as the portal gives it to you. It arrives with its base64
# padding stripped and the decoder will not accept it that way; the padding is restored for you
# before SafeChain is loaded.
CIBIS_CONSUMER_SECRET=
CIBIS_CONSUMER_INTEGRATION_ID=

# The YAML that declares the models and the request body each one expects. Most teams share a
# template -- ask on the SafeChain channel if you do not have one.
CONFIG_PATH=config.yml

# Which model to use, named exactly as your config.yml names it. Not a provider path.
LLM_MODEL_ID=gemini-2.5-pro

# Where SafeChain keeps its model factory, as module:attribute. Leave this blank: several known
# paths are tried and one of them is almost certainly right. Set it only if a call fails saying
# the factory could not be found -- `python tools/find_safechain.py` prints the line to paste.
# SAFECHAIN_MODEL_FACTORY=safechain.core_model:model

# Optional tuning.
LLM_TEMPERATURE=0.3

# Calls run on one of three tiers. Each takes its own model, output cap and reasoning effort, and
# each falls back to LLM_MODEL_ID above, so nothing changes until a smaller model is named.
#
# JUDGEMENT — reading documents, drafting the intake, materiality, review. These read a lot,
# reason at length, and justify what they conclude. Reasoning tokens come out of the same budget
# as the reply, so a high effort against a small cap truncates the JSON rather than shortening
# the answer; the cap and the effort belong together.
LLM_JUDGEMENT_MAX_TOKENS=65536
LLM_JUDGEMENT_REASONING_EFFORT=high
# LLM_JUDGEMENT_MODEL_ID=

# STANDARD — writing each scenario up for the modelling team. Mechanical and bounded by the batch
# size, but people read the result, so it stays on the main model unless you say otherwise.
LLM_MAX_TOKENS=16000
LLM_REASONING_EFFORT=minimal
# LLM_MODEL_ID is the main model, set above.

# FAST — mapping the modelling team's free-text scenarios onto the intake's declared vocabulary.
# Classification against a closed list, with validation discarding anything outside it. Point
# this at the cheapest model that follows the output format.
LLM_FAST_MAX_TOKENS=8000
LLM_FAST_REASONING_EFFORT=minimal
# LLM_FAST_MODEL_ID=

# How much submitted text goes into one reading call. Four characters to a token puts the default
# near 500k tokens, well inside a million-token input window. A pack larger than this is split
# across calls, which reads worse than reading it whole.
LLM_MAX_CORPUS_CHARS=2000000

# How many times a question the first reading left open is put back to the documents before it is
# put to the modelling team. Each pass is one call over the whole corpus, and each question it
# settles is one the team never has to answer. The last pass also decides which of the leftovers
# genuinely need a person; the rest are recorded but not asked. Set to 0 to skip the sweep, which
# is faster and asks considerably more.
LLM_INGEST_RESOLVE_PASSES=2

# How many open questions are put in front of a person at once. The rest are kept and shown behind
# a toggle rather than dropped. Only questions that stop a part of the intake being filled in are
# asked at all -- documentation is never complete, and the tool's job is not to close every gap.
LLM_MAX_OPEN_QUESTIONS=6

# Diagram reading. Submitted workflow diagrams are described by the model where it accepts
# images; set this to "off" where the gateway rejects the multimodal request shape, and diagrams
# will instead be recorded as needing a written description.
LLM_VISION=on
LLM_MAX_IMAGE_BYTES=4000000
