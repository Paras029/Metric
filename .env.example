# Yours and your machine's. Copy to .env and fill in. Never committed.
#
# How the work is *run* -- output caps, reasoning effort, batch sizes, concurrency, redaction --
# lives in tuning.yml instead, which is committed and shared. Nothing there is secret, and a
# table is easier to read and agree on than forty KEY=value lines. Any setting in that file can
# still be overridden here for one machine, by its documented environment variable name.

# Credentials for SafeChain, which reads all three straight out of the environment. Nothing in
# this package mints a token or refreshes one: SafeChain owns that, which is why it is worth using.
#
# Paste the consumer secret exactly as the portal gives it to you. It arrives with its base64
# padding stripped and the decoder will not accept it that way; the padding is restored for you
# before SafeChain is loaded.
CIBIS_CONSUMER_SECRET=
CIBIS_CONSUMER_INTEGRATION_ID=

# The YAML that declares the models available and the request body each one expects. This is
# SafeChain's own file, shared by your team -- not the tuning file above. Ask on the SafeChain
# channel if you do not have one.
CONFIG_PATH=config.yml

# Which model to call, named exactly as your config.yml names it. Not a provider path. Every tier
# in tuning.yml falls back to this, so nothing else has to be set to get started.
LLM_MODEL_ID=gemini-2.5-pro

# Where SafeChain keeps its model factory, as module:attribute. Leave this alone: several known
# paths are tried and one of them is almost certainly right. Set it only if a call fails saying
# the factory could not be found -- `python tools/find_safechain.py` prints the line to paste.
# SAFECHAIN_MODEL_FACTORY=safechain.core_model:model

# Where the tuning file lives, if not beside this one.
# TUNING_PATH=tuning.yml
