# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets / environment. Both are per-machine: .env holds the credentials, config.yml names the
# models your gateway exposes. Neither is committed, so neither is touched by a pull.
.env
config.yml

# Excel lock files
~$*.xlsx

# Generated workbooks. These carry business scenario data and are not committed
# by default; fixtures under examples/ are tracked explicitly via the negation below.
*_challenge_pack.xlsx
*_registry.xlsx
*_overlap.xlsx
*_graph.xlsx
graph.xlsx
blank_intake.xlsx
claims_intake.xlsx
!examples/*.xlsx

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local web interface workspaces (contain business scenario data).
workspaces/
